    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "summary": "Login",
        "description": "Resuelve el tenant por slug, valida credenciales y emite un access token + cookie httpOnly de refresh.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas (tenant, email o password incorrectos)."
          }
        },
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "summary": "Refresh",
        "description": "Rota el refresh token (cookie httpOnly) y emite un nuevo access token.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponseEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin cookie de refresh o sesión inválida/expirada."
          }
        },
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "summary": "Logout",
        "description": "Revoca la sesión actual (no las demás sesiones del usuario — Fase 2).",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sesión revocada."
          }
        },
        "tags": ["auth"],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
