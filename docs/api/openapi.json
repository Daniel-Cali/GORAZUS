  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UsuarioAutenticadoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": ["id", "name", "email"]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT de acceso, vida corta (~15 min)"
          },
          "user": {
            "$ref": "#/components/schemas/UsuarioAutenticadoDto"
          },
          "activeCompanyId": {
            "type": "object",
            "nullable": true
          },
          "activeBranchId": {
            "type": "object",
            "nullable": true
          }
        },
        "required": ["accessToken", "user", "activeCompanyId", "activeBranchId"]
      },
      "LoginResponseEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LoginResponseDto"
          }
        },
        "required": ["data"]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": ["accessToken"]
      },
      "RefreshResponseEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RefreshResponseDto"
          }
        },
        "required": ["data"]
      }
    }
