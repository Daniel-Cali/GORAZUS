generator client {
  provider        = "prisma-client-js"
  output          = "../generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["accounting", "assets", "banks", "bi", "cash", "configuration", "core", "crm", "customers", "hr", "inventory", "payroll", "products", "projects", "purchases", "reports", "sales", "security", "services", "suppliers", "taxes"]
}

