  local_id                                          BigInt                @unique @default(autoincrement())
  tenant_id                                         String                @db.Uuid
  company_id                                        String?               @db.Uuid
  branch_id                                         String?               @db.Uuid
  created_at                                        DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at                                        DateTime?             @db.Timestamptz(6)
  created_by                                        String?               @db.Uuid
  updated_by                                        String?               @db.Uuid
  deleted_by                                        String?               @db.Uuid
  version                                           Int                   @default(1)
  row_version                                       BigInt                @default(0)
  is_active                                         Boolean               @default(true)
  is_deleted                                        Boolean?              @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                      String?
  metadata                                          Json                  @default("{}")
  reconciliation_id                                 String                @db.Uuid
  statement_line_id                                 String?               @db.Uuid
  matched_transfer_id                               String?               @db.Uuid
  bank_transfers                                    bank_transfers?       @relation(fields: [matched_transfer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_reconciliations                              bank_reconciliations  @relation(fields: [reconciliation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_statement_lines                              bank_statement_lines? @relation(fields: [statement_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("banks")
}

