generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["banks"]
}

model bank_accounts {
  id                                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                              BigInt                 @unique @default(autoincrement())
  tenant_id                             String                 @db.Uuid
  company_id                            String                 @db.Uuid
  branch_id                             String?                @db.Uuid
  created_at                            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                            DateTime?              @db.Timestamptz(6)
  created_by                            String?                @db.Uuid
  updated_by                            String?                @db.Uuid
  deleted_by                            String?                @db.Uuid
  version                               Int                    @default(1)
  row_version                           BigInt                 @default(0)
  is_active                             Boolean                @default(true)
  is_deleted                            Boolean?               @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                          String?
  metadata                              Json                   @default("{}")
  bank_id                               String                 @db.Uuid
  account_number_encrypted              String
  currency_code                         String                 @db.Char(3)
  account_type                          String
  bank_cards                            bank_cards[]
  bank_deposits                         bank_deposits[]
  bank_payment_batches                  bank_payment_batches[]
  bank_pos_terminals                    bank_pos_terminals[]
  bank_reconciliations                  bank_reconciliations[]
  bank_statements                       bank_statements[]
  bank_transfers                        bank_transfers[]
  checkbooks                            checkbooks[]
  checks_received                       checks_received[]

  @@schema("banks")
}

model bank_cards {
  id                                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                           BigInt        @unique @default(autoincrement())
  tenant_id                          String        @db.Uuid
  company_id                         String        @db.Uuid
  branch_id                          String?       @db.Uuid
  created_at                         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at                         DateTime?     @db.Timestamptz(6)
  created_by                         String?       @db.Uuid
  updated_by                         String?       @db.Uuid
  deleted_by                         String?       @db.Uuid
  version                            Int           @default(1)
  row_version                        BigInt        @default(0)
  is_active                          Boolean       @default(true)
  is_deleted                         Boolean?      @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                       String?
  metadata                           Json          @default("{}")
  bank_account_id                    String        @db.Uuid
  card_type                          String
  last_four_digits                   String?       @db.Char(4)
  bank_accounts                      bank_accounts @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("banks")
}

model bank_deposits {
  id                                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                              BigInt          @unique @default(autoincrement())
  tenant_id                             String          @db.Uuid
  company_id                            String          @db.Uuid
  branch_id                             String?         @db.Uuid
  created_at                            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at                            DateTime?       @db.Timestamptz(6)
  created_by                            String?         @db.Uuid
  updated_by                            String?         @db.Uuid
  deleted_by                            String?         @db.Uuid
  version                               Int             @default(1)
  row_version                           BigInt          @default(0)
  is_active                             Boolean         @default(true)
  is_deleted                            Boolean?        @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                          String?
  metadata                              Json            @default("{}")
  bank_account_id                       String          @db.Uuid
  cash_register_id                      String?         @db.Uuid
  amount                                Decimal         @db.Decimal(18, 4)
  bank_accounts                         bank_accounts   @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("banks")
}

