generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["taxes"]
}

model tax_declaration_lines {
  id                                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                      BigInt           @unique @default(autoincrement())
  tenant_id                                     String           @db.Uuid
  company_id                                    String?          @db.Uuid
  branch_id                                     String?          @db.Uuid
  created_at                                    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at                                    DateTime?        @db.Timestamptz(6)
  created_by                                    String?          @db.Uuid
  updated_by                                    String?          @db.Uuid
  deleted_by                                    String?          @db.Uuid
  version                                       Int              @default(1)
  row_version                                   BigInt           @default(0)
  is_active                                     Boolean          @default(true)
  is_deleted                                    Boolean?         @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                  String?
  metadata                                      Json             @default("{}")
  declaration_id                                String           @db.Uuid
  tax_id                                        String           @db.Uuid
  amount                                        Decimal          @db.Decimal(18, 4)
  tax_declarations                              tax_declarations @relation(fields: [declaration_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxes                                         taxes            @relation(fields: [tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([declaration_id], map: "idx_taxes_tax_declaration_lines_declaration_id")
  @@index([tax_id], map: "idx_taxes_tax_declaration_lines_tax_id")
  @@schema("taxes")
}

model tax_declarations {
  id                                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                 BigInt                  @unique @default(autoincrement())
  tenant_id                                String                  @db.Uuid
  company_id                               String                  @db.Uuid
  branch_id                                String?                 @db.Uuid
  created_at                               DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at                               DateTime?               @db.Timestamptz(6)
  created_by                               String?                 @db.Uuid
  updated_by                               String?                 @db.Uuid
  deleted_by                               String?                 @db.Uuid
  version                                  Int                     @default(1)
  row_version                              BigInt                  @default(0)
  is_active                                Boolean                 @default(true)
  is_deleted                               Boolean?                @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                             String?
  metadata                                 Json                    @default("{}")
  fiscal_period_id                         String                  @db.Uuid
  filed_at                                 DateTime?               @db.Timestamptz(6)
  total_amount                             Decimal                 @db.Decimal(18, 4)
  tax_declaration_lines                    tax_declaration_lines[]

  @@index([fiscal_period_id], map: "idx_taxes_tax_declarations_fiscal_period_id")
  @@schema("taxes")
}

model tax_exemption_certificates {
  id                                                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                           BigInt         @unique @default(autoincrement())
  tenant_id                                          String         @db.Uuid
