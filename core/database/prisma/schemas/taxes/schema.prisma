  taxes                                  taxes                        @relation(fields: [tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_taxes_tax_exemptions_customer_id")
  @@index([tax_id], map: "idx_taxes_tax_exemptions_tax_id")
