model taxes {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                      BigInt                   @unique @default(autoincrement())
  tenant_id                     String                   @db.Uuid
  company_id                    String?                  @db.Uuid
  branch_id                     String?                  @db.Uuid
  created_at                    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at                    DateTime?                @db.Timestamptz(6)
  created_by                    String?                  @db.Uuid
  updated_by                    String?                  @db.Uuid
  deleted_by                    String?                  @db.Uuid
  version                       Int                      @default(1)
  row_version                   BigInt                   @default(0)
  is_active                     Boolean                  @default(true)
  is_deleted                    Boolean?                 @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                  String?
  metadata                      Json                     @default("{}")
  code                          String
  jurisdiction_id               String                   @db.Uuid
  tax_kind                      String
  tax_declaration_lines         tax_declaration_lines[]
  tax_exemptions                tax_exemptions[]
  tax_rates                     tax_rates[]
  tax_rules                     tax_rules[]
  tax_translations              tax_translations[]
  tax_jurisdictions             tax_jurisdictions        @relation(fields: [jurisdiction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jurisdiction_id], map: "idx_taxes_taxes_jurisdiction_id")
  @@schema("taxes")
}

model withholding_certificates {
  id                                               String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                         BigInt            @default(autoincrement())
  tenant_id                                        String            @db.Uuid
  company_id                                       String?           @db.Uuid
  branch_id                                        String?           @db.Uuid
  created_at                                       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at                                       DateTime?         @db.Timestamptz(6)
  created_by                                       String?           @db.Uuid
  updated_by                                       String?           @db.Uuid
  deleted_by                                       String?           @db.Uuid
  version                                          Int               @default(1)
  row_version                                      BigInt            @default(0)
  is_active                                        Boolean           @default(true)
  is_deleted                                       Boolean?          @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                     String?
  metadata                                         Json              @default("{}")
  withholding_rule_id                              String            @db.Uuid
  source_module                                    String
  source_entity_id                                 String            @db.Uuid
  amount                                           Decimal           @db.Decimal(18, 4)
  withholding_rules                                withholding_rules @relation(fields: [withholding_rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, created_at])
  @@unique([local_id, created_at])
  @@index([withholding_rule_id], map: "idx_taxes_withholding_certificates_withholding_rule_id")
  @@schema("taxes")
}

