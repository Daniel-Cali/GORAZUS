model supplier_evaluation_scores {
  id                                                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                           BigInt                       @unique @default(autoincrement())
  tenant_id                                          String                       @db.Uuid
  company_id                                         String                       @db.Uuid
  branch_id                                          String?                      @db.Uuid
  created_at                                         DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime                     @default(now()) @db.Timestamptz(6)
  deleted_at                                         DateTime?                    @db.Timestamptz(6)
  created_by                                         String?                      @db.Uuid
  updated_by                                         String?                      @db.Uuid
  deleted_by                                         String?                      @db.Uuid
  version                                            Int                          @default(1)
  row_version                                        BigInt                       @default(0)
  is_active                                          Boolean                      @default(true)
  is_deleted                                         Boolean?                     @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                       String?
  metadata                                           Json                         @default("{}")
  evaluation_id                                      String                       @db.Uuid
  criteria_id                                        String                       @db.Uuid
  score                                              Decimal                      @db.Decimal(5, 2)
  supplier_evaluation_criteria                       supplier_evaluation_criteria @relation(fields: [criteria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_evaluations                               supplier_evaluations         @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([criteria_id], map: "idx_suppliers_supplier_evaluation_scores_criteria_id")
  @@index([evaluation_id], map: "idx_suppliers_supplier_evaluation_scores_evaluation_id")
  @@schema("suppliers")
}

