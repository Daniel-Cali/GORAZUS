model suppliers {
  id                                String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                          BigInt                          @unique @default(autoincrement())
  tenant_id                         String                          @db.Uuid
  company_id                        String                          @db.Uuid
  branch_id                         String?                         @db.Uuid
  created_at                        DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime                        @default(now()) @db.Timestamptz(6)
  deleted_at                        DateTime?                       @db.Timestamptz(6)
  created_by                        String?                         @db.Uuid
  updated_by                        String?                         @db.Uuid
  deleted_by                        String?                         @db.Uuid
  version                           Int                             @default(1)
  row_version                       BigInt                          @default(0)
  is_active                         Boolean                         @default(true)
  is_deleted                        Boolean?                        @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                      String?
  metadata                          Json                            @default("{}")
  legal_name                        String
  trade_name                        String?
  tax_id                            String
  payment_terms_days                Int                             @default(0)
  is_blocked                        Boolean                         @default(false)
  block_reason                      String?
  classification_id                 String?                         @db.Uuid
  supplier_addresses                supplier_addresses[]
  supplier_bank_accounts            supplier_bank_accounts[]
  supplier_block_history            supplier_block_history[]
  supplier_contacts                 supplier_contacts[]
  supplier_contracts                supplier_contracts[]
  supplier_credit_limit_history     supplier_credit_limit_history[]
  supplier_credit_profiles          supplier_credit_profiles[]
  supplier_evaluations              supplier_evaluations[]
  supplier_history                  supplier_history[]
  supplier_withholding_profiles     supplier_withholding_profiles[]
  supplier_classifications          supplier_classifications?       @relation(fields: [classification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([classification_id], map: "idx_suppliers_suppliers_classification_id")
  @@schema("suppliers")
}

