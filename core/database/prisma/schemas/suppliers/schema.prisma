generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["suppliers"]
}

model supplier_addresses {
  id                                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                   BigInt          @unique @default(autoincrement())
  tenant_id                                  String          @db.Uuid
  company_id                                 String          @db.Uuid
  branch_id                                  String?         @db.Uuid
  created_at                                 DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at                                 DateTime?       @db.Timestamptz(6)
  created_by                                 String?         @db.Uuid
  updated_by                                 String?         @db.Uuid
  deleted_by                                 String?         @db.Uuid
  version                                    Int             @default(1)
  row_version                                BigInt          @default(0)
  is_active                                  Boolean         @default(true)
  is_deleted                                 Boolean?        @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                               String?
  metadata                                   Json            @default("{}")
  supplier_id                                String          @db.Uuid
  address_type                               String
  line1                                      String
  line2                                      String?
  municipality_id                            String?         @db.Uuid
  postal_code                                String?
  is_default                                 Boolean         @default(false)
  suppliers                                  suppliers       @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([municipality_id], map: "idx_suppliers_supplier_addresses_municipality_id")
  @@index([supplier_id], map: "idx_suppliers_supplier_addresses_supplier_id")
  @@schema("suppliers")
}

model supplier_bank_accounts {
  id                                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                       BigInt    @unique @default(autoincrement())
  tenant_id                                      String    @db.Uuid
  company_id                                     String    @db.Uuid
  branch_id                                      String?   @db.Uuid
  created_at                                     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at                                     DateTime? @db.Timestamptz(6)
  created_by                                     String?   @db.Uuid
  updated_by                                     String?   @db.Uuid
  deleted_by                                     String?   @db.Uuid
  version                                        Int       @default(1)
  row_version                                    BigInt    @default(0)
  is_active                                      Boolean   @default(true)
  is_deleted                                     Boolean?  @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                   String?
  metadata                                       Json      @default("{}")
  supplier_id                                    String    @db.Uuid
  bank_name                                      String
  encrypted_account_number                       String
  suppliers                                      suppliers @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplier_id], map: "idx_suppliers_supplier_bank_accounts_supplier_id")
  @@schema("suppliers")
}

