generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["accounting"]
}

model account_reconciliations {
  id                                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                        BigInt            @unique @default(autoincrement())
  tenant_id                                       String            @db.Uuid
  company_id                                      String            @db.Uuid
  branch_id                                       String?           @db.Uuid
  created_at                                      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at                                      DateTime?         @db.Timestamptz(6)
  created_by                                      String?           @db.Uuid
  updated_by                                      String?           @db.Uuid
  deleted_by                                      String?           @db.Uuid
  version                                         Int               @default(1)
  row_version                                     BigInt            @default(0)
  is_active                                       Boolean           @default(true)
  is_deleted                                      Boolean?          @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                    String?
  metadata                                        Json              @default("{}")
  account_id                                      String            @db.Uuid
  reconciled_balance                              Decimal           @db.Decimal(18, 4)
  subledger_balance                               Decimal           @db.Decimal(18, 4)
  chart_of_accounts                               chart_of_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("accounting")
}

