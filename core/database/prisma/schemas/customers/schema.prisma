  legal_name                        String
  trade_name                        String?
  tax_id                            String
  tax_regime                        String?
  preferred_currency_code           String                          @db.Char(3)
  assigned_salesperson_id           String?                         @db.Uuid
  is_blocked                        Boolean                         @default(false)
  block_reason                      String?
  classification_id                 String?                         @db.Uuid
  category_id                       String?                         @db.Uuid
  customer_addresses                customer_addresses[]
  customer_bank_accounts            customer_bank_accounts[]
  customer_block_history            customer_block_history[]
  customer_contacts                 customer_contacts[]
  customer_credit_limit_history     customer_credit_limit_history[]
  customer_credit_profiles          customer_credit_profiles[]
  customer_discounts                customer_discounts[]
  customer_loyalty_accounts         customer_loyalty_accounts[]
