  customer_references               customer_references[]
  customer_statements               customer_statements[]
  customer_visits                   customer_visits[]
  customer_wishlist_items           customer_wishlist_items[]
  customer_categories               customer_categories?            @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_classifications          customer_classifications?       @relation(fields: [classification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_route_customers             sales_route_customers[]

  @@index([assigned_salesperson_id], map: "idx_customers_customers_assigned_salesperson_id")
  @@index([category_id], map: "idx_customers_customers_category_id")
  @@index([classification_id], map: "idx_customers_customers_classification_id")
