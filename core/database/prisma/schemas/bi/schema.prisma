generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bi"]
}

model bi_alert_triggers {
  id                                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                  BigInt     @unique @default(autoincrement())
  tenant_id                                 String     @db.Uuid
  company_id                                String?    @db.Uuid
  branch_id                                 String?    @db.Uuid
  created_at                                DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                                DateTime?  @db.Timestamptz(6)
  created_by                                String?    @db.Uuid
  updated_by                                String?    @db.Uuid
  deleted_by                                String?    @db.Uuid
  version                                   Int        @default(1)
  row_version                               BigInt     @default(0)
  is_active                                 Boolean    @default(true)
  is_deleted                                Boolean?   @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                              String?
  metadata                                  Json       @default("{}")
  alert_id                                  String     @db.Uuid
  observed_value                            Decimal    @db.Decimal(18, 4)
  bi_alerts                                 bi_alerts  @relation(fields: [alert_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([alert_id], map: "idx_bi_bi_alert_triggers_alert_id")
  @@schema("bi")
}

model bi_alerts {
  id                                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                          BigInt              @unique @default(autoincrement())
  tenant_id                         String              @db.Uuid
  company_id                        String              @db.Uuid
  branch_id                         String?             @db.Uuid
  created_at                        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                        DateTime?           @db.Timestamptz(6)
  created_by                        String?             @db.Uuid
  updated_by                        String?             @db.Uuid
  deleted_by                        String?             @db.Uuid
  version                           Int                 @default(1)
  row_version                       BigInt              @default(0)
  is_active                         Boolean             @default(true)
  is_deleted                        Boolean?            @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                      String?
  metadata                          Json                @default("{}")
  kpi_id                            String?             @db.Uuid
  indicator_id                      String?             @db.Uuid
  metric_id                         String?             @db.Uuid
  threshold_operator                String
  threshold_value                   Decimal             @db.Decimal(18, 4)
  bi_alert_triggers                 bi_alert_triggers[]
  indicators                        indicators?         @relation(fields: [indicator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kpis                              kpis?               @relation(fields: [kpi_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metrics                           metrics?            @relation(fields: [metric_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([indicator_id], map: "idx_bi_bi_alerts_indicator_id")
  @@index([kpi_id], map: "idx_bi_bi_alerts_kpi_id")
  @@index([metric_id], map: "idx_bi_bi_alerts_metric_id")
  @@schema("bi")
}

