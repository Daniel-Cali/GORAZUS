  service_orders                                 service_orders @relation(fields: [service_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technicians                                    technicians    @relation(fields: [technician_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_order_id], map: "idx_services_technician_assignments_service_order_id")
  @@index([technician_id], map: "idx_services_technician_assignments_technician_id")
  @@schema("services")
}

model technicians {
  id                                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                            BigInt                   @unique @default(autoincrement())
  tenant_id                           String                   @db.Uuid
  company_id                          String                   @db.Uuid
  branch_id                           String?                  @db.Uuid
  created_at                          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at                          DateTime?                @db.Timestamptz(6)
  created_by                          String?                  @db.Uuid
  updated_by                          String?                  @db.Uuid
  deleted_by                          String?                  @db.Uuid
  version                             Int                      @default(1)
  row_version                         BigInt                   @default(0)
  is_active                           Boolean                  @default(true)
  is_deleted                          Boolean?                 @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                        String?
  metadata                            Json                     @default("{}")
  employee_id                         String?                  @db.Uuid
  full_name                           String
  service_visits                      service_visits[]
  technician_assignments              technician_assignments[]

  @@index([employee_id], map: "idx_services_technicians_employee_id")
  @@schema("services")
}
