generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["services"]
}

model equipment {
  id                                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                          BigInt              @unique @default(autoincrement())
  tenant_id                         String              @db.Uuid
  company_id                        String              @db.Uuid
  branch_id                         String?             @db.Uuid
  created_at                        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                        DateTime?           @db.Timestamptz(6)
  created_by                        String?             @db.Uuid
  updated_by                        String?             @db.Uuid
  deleted_by                        String?             @db.Uuid
  version                           Int                 @default(1)
  row_version                       BigInt              @default(0)
  is_active                         Boolean             @default(true)
  is_deleted                        Boolean?            @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                      String?
  metadata                          Json                @default("{}")
  customer_id                       String              @db.Uuid
  equipment_type_id                 String              @db.Uuid
  serial_number                     String?
  model                             String?
  equipment_types                   equipment_types     @relation(fields: [equipment_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_plans                 maintenance_plans[]
  service_orders                    service_orders[]

  @@index([customer_id], map: "idx_services_equipment_customer_id")
  @@index([equipment_type_id], map: "idx_services_equipment_equipment_type_id")
  @@schema("services")
}

model equipment_types {
  id                                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                BigInt      @unique @default(autoincrement())
  tenant_id                               String      @db.Uuid
  company_id                              String?     @db.Uuid
  branch_id                               String?     @db.Uuid
  created_at                              DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at                              DateTime?   @db.Timestamptz(6)
  created_by                              String?     @db.Uuid
  updated_by                              String?     @db.Uuid
  deleted_by                              String?     @db.Uuid
  version                                 Int         @default(1)
  row_version                             BigInt      @default(0)
  is_active                               Boolean     @default(true)
  is_deleted                              Boolean?    @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                            String?
  metadata                                Json        @default("{}")
  name                                    String
  equipment                               equipment[]

  @@schema("services")
}

model maintenance_plans {
  id                                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                  BigInt                   @unique @default(autoincrement())
  tenant_id                                 String                   @db.Uuid
