generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["hr"]
}

model attendance_devices {
  id                                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                   BigInt               @unique @default(autoincrement())
  tenant_id                                  String               @db.Uuid
  company_id                                 String?              @db.Uuid
  branch_id                                  String               @db.Uuid
  created_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at                                 DateTime?            @db.Timestamptz(6)
  created_by                                 String?              @db.Uuid
  updated_by                                 String?              @db.Uuid
  deleted_by                                 String?              @db.Uuid
  version                                    Int                  @default(1)
  row_version                                BigInt               @default(0)
  is_active                                  Boolean              @default(true)
  is_deleted                                 Boolean?             @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                               String?
  metadata                                   Json                 @default("{}")
  name                                       String
  device_type                                String
  attendance_records                         attendance_records[]

  @@schema("hr")
}

model attendance_records {
  id                                         String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                   BigInt              @default(autoincrement())
  tenant_id                                  String              @db.Uuid
  company_id                                 String              @db.Uuid
  branch_id                                  String?             @db.Uuid
  created_at                                 DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                                 DateTime?           @db.Timestamptz(6)
  created_by                                 String?             @db.Uuid
  updated_by                                 String?             @db.Uuid
  deleted_by                                 String?             @db.Uuid
  version                                    Int                 @default(1)
  row_version                                BigInt              @default(0)
  is_active                                  Boolean             @default(true)
  is_deleted                                 Boolean?            @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                               String?
  metadata                                   Json                @default("{}")
  employee_id                                String              @db.Uuid
  device_id                                  String?             @db.Uuid
  check_type                                 String
  checked_at                                 DateTime            @db.Timestamptz(6)
  attendance_devices                         attendance_devices? @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                                  employees           @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, checked_at])
  @@unique([local_id, checked_at])
  @@schema("hr")
}

