generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["sales"]
}

model commission_entries {
  id                                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                   BigInt                       @unique @default(autoincrement())
  tenant_id                                  String                       @db.Uuid
  company_id                                 String?                      @db.Uuid
  branch_id                                  String?                      @db.Uuid
  created_at                                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime                     @default(now()) @db.Timestamptz(6)
  deleted_at                                 DateTime?                    @db.Timestamptz(6)
  created_by                                 String?                      @db.Uuid
  updated_by                                 String?                      @db.Uuid
  deleted_by                                 String?                      @db.Uuid
  version                                    Int                          @default(1)
  row_version                                BigInt                       @default(0)
  is_active                                  Boolean                      @default(true)
  is_deleted                                 Boolean?                     @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                               String?
  metadata                                   Json                         @default("{}")
  commission_rule_id                         String                       @db.Uuid
  invoice_id                                 String                       @db.Uuid
  amount                                     Decimal                      @db.Decimal(18, 4)
  commission_rules                           commission_rules             @relation(fields: [commission_rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([commission_rule_id], map: "idx_sales_commission_entries_salesperson")
  @@schema("sales")
}

model commission_rules {
  id                                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                 BigInt               @unique @default(autoincrement())
  tenant_id                                String               @db.Uuid
  company_id                               String?              @db.Uuid
  branch_id                                String?              @db.Uuid
