model invoices {
  id                               String                 @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                         BigInt                 @default(autoincrement())
  tenant_id                        String                 @db.Uuid
  company_id                       String                 @db.Uuid
  branch_id                        String                 @db.Uuid
  created_at                       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                       DateTime?              @db.Timestamptz(6)
  created_by                       String?                @db.Uuid
  updated_by                       String?                @db.Uuid
  deleted_by                       String?                @db.Uuid
  version                          Int                    @default(1)
  row_version                      BigInt                 @default(0)
  is_active                        Boolean                @default(true)
  is_deleted                       Boolean?               @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                     String?
  metadata                         Json                   @default("{}")
  document_number                  String
  fiscal_document_type_id          String?                @db.Uuid
  customer_id                      String                 @db.Uuid
  sales_order_id                   String?                @db.Uuid
  status_id                        String                 @db.Uuid
  sales_channel                    String                 @default("store")
  currency_code                    String                 @db.Char(3)
  subtotal_amount                  Decimal                @default(0) @db.Decimal(18, 4)
  tax_amount                       Decimal                @default(0) @db.Decimal(18, 4)
  total_amount                     Decimal                @default(0) @db.Decimal(18, 4)
  issued_at                        DateTime               @default(now()) @db.Timestamptz(6)
  general_discount_percentage      Decimal                @default(0) @db.Decimal(5, 2)
  sales_orders                     sales_orders?          @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_status                   invoice_status         @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, issued_at])
  @@unique([local_id, issued_at])
