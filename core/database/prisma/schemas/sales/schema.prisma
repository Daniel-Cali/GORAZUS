  deleted_by                               String?              @db.Uuid
  version                                  Int                  @default(1)
  row_version                              BigInt               @default(0)
  is_active                                Boolean              @default(true)
  is_deleted                               Boolean?             @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                             String?
  metadata                                 Json                 @default("{}")
  salesperson_id                           String?              @db.Uuid
  commission_percentage                    Decimal              @db.Decimal(5, 2)
  commission_entries                       commission_entries[]
  salespeople                              salespeople?         @relation(fields: [salesperson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([salesperson_id], map: "idx_sales_commission_rules_salesperson_id")
  @@schema("sales")
}

