  updated_at                         DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at                         DateTime?         @db.Timestamptz(6)
  created_by                         String?           @db.Uuid
  updated_by                         String?           @db.Uuid
  deleted_by                         String?           @db.Uuid
  version                            Int               @default(1)
  row_version                        BigInt            @default(0)
  is_active                          Boolean           @default(true)
  is_deleted                         Boolean?          @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                       String?
  metadata                           Json              @default("{}")
  invoice_line_id                    String            @db.Uuid
  product_id                         String            @db.Uuid
  coverage_months                    Int
  expires_at                         DateTime          @db.Date
  invoice_lines                      invoice_lines     @relation(fields: [invoice_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warranty_claims                    warranty_claims[]

  @@index([invoice_line_id], map: "idx_sales_warranties_invoice_line_id")
  @@index([product_id], map: "idx_sales_warranties_product_id")
  @@schema("sales")
}

model warranty_claims {
  id                                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                BigInt     @unique @default(autoincrement())
  tenant_id                               String     @db.Uuid
  company_id                              String?    @db.Uuid
  branch_id                               String?    @db.Uuid
  created_at                              DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                              DateTime?  @db.Timestamptz(6)
  created_by                              String?    @db.Uuid
  updated_by                              String?    @db.Uuid
  deleted_by                              String?    @db.Uuid
  version                                 Int        @default(1)
  row_version                             BigInt     @default(0)
  is_active                               Boolean    @default(true)
  is_deleted                              Boolean?   @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                            String?
  metadata                                Json       @default("{}")
  warranty_id                             String     @db.Uuid
  claim_description                       String
  status                                  String     @default("open")
  warranties                              warranties @relation(fields: [warranty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([warranty_id], map: "idx_sales_warranty_claims_warranty_id")
  @@schema("sales")
}
