generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["crm"]
}

model calendar_event_attendees {
  id                                               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                         BigInt          @unique @default(autoincrement())
  tenant_id                                        String          @db.Uuid
  company_id                                       String?         @db.Uuid
  branch_id                                        String?         @db.Uuid
  created_at                                       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at                                       DateTime?       @db.Timestamptz(6)
  created_by                                       String?         @db.Uuid
  updated_by                                       String?         @db.Uuid
  deleted_by                                       String?         @db.Uuid
  version                                          Int             @default(1)
  row_version                                      BigInt          @default(0)
  is_active                                        Boolean         @default(true)
  is_deleted                                       Boolean?        @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                                     String?
  metadata                                         Json            @default("{}")
  event_id                                         String          @db.Uuid
  user_id                                          String?         @db.Uuid
  external_email                                   String?
  calendar_events                                  calendar_events @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("crm")
}

model calendar_events {
  id                                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                                   BigInt                     @unique @default(autoincrement())
  tenant_id                                  String                     @db.Uuid
  company_id                                 String?                    @db.Uuid
  branch_id                                  String?                    @db.Uuid
  created_at                                 DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime                   @default(now()) @db.Timestamptz(6)
  deleted_at                                 DateTime?                  @db.Timestamptz(6)
  created_by                                 String?                    @db.Uuid
  updated_by                                 String?                    @db.Uuid
  deleted_by                                 String?                    @db.Uuid
  version                                    Int                        @default(1)
  row_version                                BigInt                     @default(0)
  is_active                                  Boolean                    @default(true)
  is_deleted                                 Boolean?                   @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                               String?
  metadata                                   Json                       @default("{}")
  owner_user_id                              String                     @db.Uuid
  title                                      String
  starts_at                                  DateTime                   @db.Timestamptz(6)
  ends_at                                    DateTime                   @db.Timestamptz(6)
  lead_id                                    String?                    @db.Uuid
  opportunity_id                             String?                    @db.Uuid
  calendar_event_attendees                   calendar_event_attendees[]
  leads                                      leads?                     @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunities                              opportunities?             @relation(fields: [opportunity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("crm")
}

model call_logs {
  id                                String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                          BigInt     @default(autoincrement())
  tenant_id                         String     @db.Uuid
  company_id                        String?    @db.Uuid
  branch_id                         String?    @db.Uuid
  created_at                        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                        DateTime?  @db.Timestamptz(6)
  created_by                        String?    @db.Uuid
  updated_by                        String?    @db.Uuid
  deleted_by                        String?    @db.Uuid
  version                           Int        @default(1)
  row_version                       BigInt     @default(0)
  is_active                         Boolean    @default(true)
  is_deleted                        Boolean?   @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                      String?
  metadata                          Json       @default("{}")
  lead_id                           String?    @db.Uuid
  customer_id                       String?    @db.Uuid
  duration_seconds                  Int?
  outcome                           String?
  leads                             leads?     @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, created_at])
  @@unique([local_id, created_at])
  @@schema("crm")
}

