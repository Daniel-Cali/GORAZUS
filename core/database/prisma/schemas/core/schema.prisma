generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model activity_logs {
  id                                    String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                              BigInt     @default(autoincrement())
  tenant_id                             String     @db.Uuid
  company_id                            String?    @db.Uuid
  branch_id                             String?    @db.Uuid
  created_at                            DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                            DateTime?  @db.Timestamptz(6)
  created_by                            String?    @db.Uuid
  updated_by                            String?    @db.Uuid
  deleted_by                            String?    @db.Uuid
  version                               Int        @default(1)
  row_version                           BigInt     @default(0)
  is_active                             Boolean    @default(true)
  is_deleted                            Boolean?   @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                          String?
  metadata                              Json       @default("{}")
  user_id                               String     @db.Uuid
  action_code                           String
  entity_type                           String?
  entity_id                             String?    @db.Uuid
  branches                              branches?  @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies                             companies? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_activity_logs_created_byTousers users?     @relation("activity_logs_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_activity_logs_deleted_byTousers users?     @relation("activity_logs_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                               tenants    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_activity_logs_updated_byTousers users?     @relation("activity_logs_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_activity_logs_user_idTousers    users      @relation("activity_logs_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, created_at])
  @@unique([local_id, created_at])
  @@schema("core")
}

model api_key_scopes {
  id                                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id                               BigInt      @unique @default(autoincrement())
  tenant_id                              String      @db.Uuid
  company_id                             String?     @db.Uuid
  branch_id                              String?     @db.Uuid
  created_at                             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at                             DateTime?   @db.Timestamptz(6)
  created_by                             String?     @db.Uuid
  updated_by                             String?     @db.Uuid
  deleted_by                             String?     @db.Uuid
  version                                Int         @default(1)
  row_version                            BigInt      @default(0)
  is_active                              Boolean     @default(true)
  is_deleted                             Boolean?    @default(dbgenerated("(deleted_at IS NOT NULL)"))
  observations                           String?
  metadata                               Json        @default("{}")
  api_key_id                             String      @db.Uuid
  permission_id                          String      @db.Uuid
  api_keys                               api_keys    @relation(fields: [api_key_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches                               branches?   @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies                              companies?  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_api_key_scopes_created_byTousers users?      @relation("api_key_scopes_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_api_key_scopes_deleted_byTousers users?      @relation("api_key_scopes_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permissions                            permissions @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                                tenants     @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_api_key_scopes_updated_byTousers users?      @relation("api_key_scopes_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("core")
}

