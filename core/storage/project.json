{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core-storage",
  "sourceRoot": "core/storage",
  "projectType": "library",
  "tags": ["type:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/core/storage"],
      "options": {
        "command": "tsc -p core/storage/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/core/storage"],
      "options": {
        "jestConfig": "core/storage/jest.config.ts"
      }
    }
  }
}
