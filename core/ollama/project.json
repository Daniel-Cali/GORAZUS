{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core-ollama",
  "sourceRoot": "core/ollama",
  "projectType": "library",
  "tags": ["type:core"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/core/ollama",
        "main": "core/ollama/index.ts",
        "tsConfig": "core/ollama/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/core/ollama"],
      "options": {
        "jestConfig": "core/ollama/jest.config.ts"
      }
    }
  }
}
