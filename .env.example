# GORAZUS ERP — variables de entorno de referencia.
# Copiar a .env (gitignored, nunca se commitea) y completar valores reales.
# Validado al boot vía schema Zod en core/config (fail-fast si falta
# una variable requerida) — ver docs/architecture/08 §6 y
# docs/architecture/12-backend-enterprise.md §7.

NODE_ENV=development

# --- Postgres backup (FASE 05, ver infra/postgres/backup/) ---
POSTGRES_BACKUP_PASSWORD=

# --- Postgres ---
# POSTGRES_USER = superusuario de bootstrap del contenedor (initdb) — NUNCA
# "gorazus_app": la imagen oficial de Postgres crea ese usuario como
# superusuario, y "gorazus_app" es el rol de aplicación LIMITADO que crea
# 30_backup_restore.sql — el mismo nombre en ambos colisiona y deja el rol de
# aplicación con superusuario real (RLS se vuelve un no-op), ver
# docs/database/SECURITY.md §2.
POSTGRES_USER=gorazus_superuser
POSTGRES_PASSWORD=
POSTGRES_DB=gorazus
# Password de gorazus_app — usada también por docker-compose.yml para armar
# DATABASE_URL con el hostname interno de Docker.
POSTGRES_APP_PASSWORD=
DATABASE_URL=postgresql://gorazus_app:CHANGE_ME@postgres:5432/gorazus?schema=core

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- RabbitMQ ---
RABBITMQ_USER=gorazus_app
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://gorazus_app:CHANGE_ME@rabbitmq:5672

# --- MinIO ---
MINIO_ROOT_USER=gorazus_app
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# --- Auth (ver docs/architecture/13-modulo-auth.md) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- API ---
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite, ver apps/web/src/main.tsx) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- SMTP (en local apunta a MailHog, ver infra/mailhog/README.md) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Notification Center (Fase 1: canal WhatsApp, ver core/notifications) ---
# Clave AES-256-GCM hex de 64 caracteres (32 bytes) para core.integration_credentials.encrypted_value — nunca commitear un valor real.
NOTIFICATIONS_ENCRYPTION_KEY=
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Ollama (FASE 04, infraestructura de IA — ver core/ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a usar por defecto — sin valor por defecto en código a propósito (ver env.schema.ts), completar con un modelo ya descargado vía `ollama pull <modelo>`.
OLLAMA_DEFAULT_MODEL=

# --- Seguridad (Fase 02: cifrado de secretos 2FA, ver modules/seguridad/backend) ---
# Clave AES-256-GCM hex de 64 caracteres (32 bytes) para security.two_factor_credentials.encrypted_secret — nunca commitear un valor real.
SEGURIDAD_ENCRYPTION_KEY=

# --- pgAdmin (solo docker-compose.dev.yml) ---
PGADMIN_PASSWORD=

# --- Observabilidad (opcional, con default — ver core/observability/) ---
METRICS_PORT=9464
OTEL_EXPORTER_OTLP_ENDPOINT=
