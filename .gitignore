# Dependencias
node_modules/

# Build
dist/
build/
tmp/
out-tsc/

# Nx
.nx/cache
.nx/workspace-data

# Entornos y secretos — nunca se commitean (ver docs/architecture/08 §6)
.env
infra/nginx/certs/
.env.*
!.env.example

# Prisma (el cliente generado no se commitea, se regenera del schema)
apps/api/prisma/generated/
core/database/generated/
# 21 clientes, uno por schema — ver core/database/src/database.module.ts
core/database/prisma/schemas/*/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Coverage
coverage/

# Herramientas portables de terceros (DBeaver, Graphviz, SchemaSpy, JDK — ~450MB,
# binarios descargados, no código propio) — ver tools/database/README.md
# para cómo reinstalarlas, nunca se commitean.
tools/database/dbeaver/
tools/database/graphviz/
tools/database/schemaspy/
tools/database/jdk-21/
tools/database/pgsql-client-17/

# ERDs generados por SchemaSpy (~2.3GB, regenerable desde la base real vía
# docs/database/DATABASE_VISUALIZATION.md §4) — "no se versionan como fuente
# editable" (ya documentado en ese archivo, §7), nunca se commitean.
docs/database/erd/

# Vite
apps/web/dist/
apps/web/.vite/

# Playwright — binarios de navegador SIEMPRE bajo el proyecto (nunca C:\, ver
# docs/architecture, regla permanente "prohibido usar disco C:"). Instalar con:
# PLAYWRIGHT_BROWSERS_PATH="$PWD/.playwright-browsers" npx playwright install chromium
.playwright-browsers/
apps/web-e2e/playwright-report/
apps/web-e2e/test-results/

# Respaldos de PostgreSQL (pg_dump) — datos reales, nunca se commitean.
# Vive en D:\ (regla "prohibido usar disco C:\"), ver infra/docker/README.md §7.
backups/
backups/*.dump
backups/*/*.dump
migration-baseline-*.txt

# Storage físico de PostgreSQL (bind mount, FASE 1 migración C:\ -> D:\) —
# datos binarios reales de la base, nunca se commitean. Ver infra/docker/README.md.
docker-data/

# Archivos personales de sesión AI (no reutilizables, específico de sesión) —
# Información importante debe estar en docs/, PROJECT_STATUS.md, etc.
.claude/SESSION_STATE.md
.claude/MEMORY.md
.claude/scheduled_tasks.lock
.claude/settings.json

# Archivos de sesión anterior (conversaciones punto-en-tiempo, no documentación oficial)
# La información debe estar consolidada en:
# - PROJECT_STATUS.md (estado actual)
# - CHANGELOG.md (historial de cambios)
# - docs/ (documentación oficial)
GORAZUS_CONVERSATION_BACKUP.md
SESSION_BACKUP.md
RESUMEN_SESION_PARA_GPT.txt

# Carpeta de referencias personales (no debe estar en repo público/shared)
# Usar docs/ para referencias oficiales del proyecto
pdf ideas/

